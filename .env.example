# ============================================================================
# OneVishwam Admin — Environment Variables Template
# ============================================================================
# Copy this file to `.env` (or `.env.development` / `.env.production`) and fill
# in the values. Real values must NEVER be committed — `.env*` is gitignored
# (this template is the only exception).
#
# Local dev:    VITE_API_URL / VITE_API_BASE_URL = http://localhost:5001/api
# Production:   VITE_API_URL / VITE_API_BASE_URL = https://asia-south1-onevishwam.cloudfunctions.net/api
#
# Tip: `npm run env:local` / `npm run env:prod` rewrite the two API URLs in
# `.env` for you. `npm run build` (via scripts/ensure-prod-env.js) forces the
# production URL into `.env.production` and `.env` before every build.
# ============================================================================

# --- API ---------------------------------------------------------------------
# Base URL for the OneVishwam backend (no trailing slash).
VITE_API_URL=
VITE_API_BASE_URL=

# Optional per-mode overrides read by src/api/client.js. Leave blank to fall
# back to the built-in localhost (dev) / Cloud Functions (prod) defaults.
VITE_DEV_API_URL=
VITE_PROD_API_URL=

# --- Admin console -----------------------------------------------------------
# Pre-fills the login form and is used as the password Firebase Auth verifies.
# Treat this as PUBLIC: Vite inlines it into the client bundle, so it provides
# no real secrecy. Rotate it in Firebase Auth if it has been exposed.
VITE_ADMIN_PASSWORD=

# --- Firebase client SDK -----------------------------------------------------
# Safe to expose (Firebase web config is not a secret), but keep it out of git
# anyway so environments stay in sync with the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
